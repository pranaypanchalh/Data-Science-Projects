      "        [[#isForFilter]] [[^isPaginating]]\n",
      "          <div\n",
      "            class=\"\n",
      "              wizzy-progress-container [[#isForFilter]][[^isPaginating]]for-filter[[/isPaginating]][[/isForFilter]]\n",
      "              [[#isPaginating]]for-pagination[[/isPaginating]]\n",
      "            \"\n",
      "          >\n",
      "            <div class=\"wizzy-progress\">\n",
      "              <div class=\"wizzy-lds-ellipsis\">\n",
      "                <div></div>\n",
      "                <div></div>\n",
      "                <div></div>\n",
      "                <div></div>\n",
      "              </div>\n",
      "              <!-- ending of wizzy-lds-ellipsis -->\n",
      "            </div>\n",
      "            <!-- ending of wizzy-progress -->\n",
      "          </div>\n",
      "          <!-- ending of wizzy-progress-container -->\n",
      "          <div class=\"wizzy-progress-bg for-filter\"></div>\n",
      "          <!-- ending of wizzy-progress-bg -->\n",
      "        [[/isPaginating]] [[/isForFilter]]\n",
      "      </div><!-- ending of wizzy-progress-template -->\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-common-select'>\n",
      "    <div class=\"wizzy-common-select-wrapper\">\n",
      "        <div class=\"wizzy-common-select-container\">\n",
      "            <div class=\"wizzy-common-select-overlay\"></div>\n",
      "            <div class=\"wizzy-common-select-selector\">\n",
      "            <span class=\"wizzy-common-select-label\">\n",
      "                [[#label]]\n",
      "                [[&label]]\n",
      "                [[/label]]\n",
      "            </span>\n",
      "                <span class=\"wizzy-common-select-selectedItem\">\n",
      "                [[&selectedItem]]\n",
      "            </span>\n",
      "            </div>\n",
      "\n",
      "\n",
      "            <div class=\"wizzy-common-select-options\">\n",
      "                [[#items]]\n",
      "                <div class=\"wizzy-common-select-option [[#isSelected]]selected[[/isSelected]]\" title=\"[[&label]]\">\n",
      "                    [[&label]]\n",
      "                </div>\n",
      "                [[/items]]\n",
      "            </div>\n",
      "        </div>\n",
      "    </div>\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-facet-category-item'>\n",
      "    <li class=\"wizzy-facet-list-item facet-category-hierarchy-item [[#isSelected]]active[[/isSelected]] [[#hasAnyChildSelected]]active[[/hasAnyChildSelected]]\"\n",
      "        data-key=\"[[ key ]]\" data-term=\"[[& label ]]\" title=\"[[& label ]]\">\n",
      "        <span class=\"wizzy-facet-list-item-label\">\n",
      "            <span class=\"wizzy-facet-list-item-checkbox\">\n",
      "                <input type=\"checkbox\" class=\"wizzy-facet-list-item-checkbox-input\" [[#isSelected]]checked[[/isSelected]] />\n",
      "                <div class=\"checkbox-indicator\"></div>\n",
      "            </span>\n",
      "            [[& label ]]\n",
      "        </span>\n",
      "        <span class=\"wizzy-facet-list-item-count\">\n",
      "            ([[ count ]])\n",
      "        </span>\n",
      "\n",
      "        [[#childrenHTML]]\n",
      "        <ul class=\"wizzy-facet-list facet-child-list\">\n",
      "            [[&childrenHTML]]\n",
      "        </ul>\n",
      "        [[/childrenHTML]]\n",
      "    </li>\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-facet-block'>\n",
      "    <div class=\"wizzy-filters-facet-block\n",
      "facet-block-[[ divKey ]]\n",
      "facet-block-[[#isLeft]]left [[#leftFacetCollapsible]]collapsible[[/leftFacetCollapsible]]\n",
      "[[#leftDefaultCollapsed]][[^isSelected]]collapsed[[/isSelected]][[/leftDefaultCollapsed]]\n",
      "[[#firstLeftDefaultOpened]]first-opened[[/firstLeftDefaultOpened]][[/isLeft]][[^isLeft]]top[[/isLeft]]\"\n",
      "         data-key=\"[[ key ]]\" [[#parentKey]]data-parentKey=\"[[parentKey]]\" [[/parentKey]]>\n",
      "    <div class=\"wizzy-facet-head facet-head-[[divKey]]\" title=\"[[& title ]]\">\n",
      "        <span class=\"facet-head-title\">\n",
      "            [[& title ]]\n",
      "        </span>\n",
      "        <span class=\"wz-active-facets\"></span>\n",
      "        <span class=\"facet-head-right\">\n",
      "\n",
      "        </span>\n",
      "    </div>\n",
      "    <div class=\"wizzy-facet-body facet-body-[[divKey]]\">\n",
      "        <div class=\"facet-search-wrapper\">\n",
      "            <input type=\"text\" class=\"facet-head-search-input\" placeholder=\"Search [[ title ]]\" />\n",
      "            [[#withSearch]]\n",
      "            <div class=\"facet-head-search\">\n",
      "                <a href=\"#\" class=\"facet-head-search-icon\" title=\"Search [[ title ]]\"></a>\n",
      "            </div>\n",
      "            [[/withSearch]]\n",
      "        </div>\n",
      "\n",
      "        <ul class=\"wizzy-facet-list\">\n",
      "            [[#items]]\n",
      "            [[&html]]\n",
      "            [[/items]]\n",
      "        </ul>\n",
      "    </div>\n",
      "    </div>\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-facet-item-common'>\n",
      "    <li class=\"wizzy-facet-list-item [[#isSwatch]]facet-has-swatch[[/isSwatch]] [[#isSelected]]active[[/isSelected]]\"\n",
      "        data-key=\"[[ key ]]\" data-term=\"[[& label ]]\" title=\"[[& label ]]\">\n",
      "    <span class=\"wizzy-facet-list-item-label\">\n",
      "    <span class=\"wizzy-facet-list-item-checkbox\">\n",
      "        <input type=\"checkbox\" class=\"wizzy-facet-list-item-checkbox-input\" [[#isSelected]]checked[[/isSelected]] />\n",
      "        <div class=\"checkbox-indicator\"></div>\n",
      "    </span>\n",
      "\n",
      "[[#isSwatch]]\n",
      "<span class=\"wizzy-facet-item-swatch-wrapper [[#isVisualSwatch]]facet-visual-swatch[[/isVisualSwatch]]\n",
      "    [[^isVisualSwatch]]facet-text-swatch[[/isVisualSwatch]]\">\n",
      "    <span class=\"wizzy-facet-item-swatch [[#isVisualSwatch]]facet-visual-swatch[[/isVisualSwatch]]\n",
      "        [[^isVisualSwatch]]facet-text-swatch[[/isVisualSwatch]]\"\n",
      "          style=\"[[#isVisualSwatch]][[#isURLSwatch]]background-image:url([[swatchValue]]);[[/isURLSwatch]]\n",
      "            [[^isURLSwatch]]background-color:[[swatchValue]];[[/isURLSwatch]][[/isVisualSwatch]]\">\n",
      "        [[#value]]\n",
      "            <span class=\"wizzy-facet-swatch-individual-value\">[[value]]</span>\n",
      "        [[/value]]\n",
      "        [[^isVisualSwatch]]\n",
      "            <span class=\"wizzy-facet-swatch-value\">[[swatchValue]]</span>\n",
      "        [[/isVisualSwatch]]\n",
      "    </span>\n",
      "</span>\n",
      "[[/isSwatch]]\n",
      "\n",
      "\n",
      "    <span class=\"facet-item-label-value\">[[& label ]]</span>\n",
      "    </span>\n",
      "        <span class=\"wizzy-facet-list-item-count\">\n",
      "    ([[ count ]])\n",
      "    </span>\n",
      "    </li>\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-selected-facet-item-common'>\n",
      "    <li class=\"wizzy-selected-facet-list-item [[#isSwatch]]facet-has-swatch[[/isSwatch]]\" data-facetKey=\"[[facetKey]]\"\n",
      "        data-key=\"[[ key ]]\" data-term=\"[[& label ]]\" title=\"[[& label ]]\">\n",
      "    <span class=\"wizzy-selected-facet-list-item-label\">\n",
      "\n",
      "\n",
      "        [[#isSwatch]]\n",
      "<span class=\"wizzy-facet-item-swatch-wrapper [[#isVisualSwatch]]facet-visual-swatch[[/isVisualSwatch]]\n",
      "    [[^isVisualSwatch]]facet-text-swatch[[/isVisualSwatch]]\">\n",
      "    <span class=\"wizzy-facet-item-swatch [[#isVisualSwatch]]facet-visual-swatch[[/isVisualSwatch]]\n",
      "        [[^isVisualSwatch]]facet-text-swatch[[/isVisualSwatch]]\"\n",
      "          style=\"[[#isVisualSwatch]][[#isURLSwatch]]background-image:url([[swatchValue]]);[[/isURLSwatch]]\n",
      "            [[^isURLSwatch]]background-color:[[swatchValue]];[[/isURLSwatch]][[/isVisualSwatch]]\">\n",
      "        [[#value]]\n",
      "            <span class=\"wizzy-facet-swatch-individual-value\">[[value]]</span>\n",
      "        [[/value]]\n",
      "        [[^isVisualSwatch]]\n",
      "            <span class=\"wizzy-facet-swatch-value\">[[swatchValue]]</span>\n",
      "        [[/isVisualSwatch]]\n",
      "    </span>\n",
      "</span>\n",
      "[[/isSwatch]]\n",
      "\n",
      "\n",
      "\n",
      "\n",
      "        <span class=\"facet-item-label-value\"> \n",
      "            [[# labelKey ]] \n",
      "                <span class=\"facet-item-label-value-id\"> [[& labelKey ]] :</span> \n",
      "            [[/ labelKey ]] [[& label ]] \n",
      "        </span>\n",
      "    </span>\n",
      "        <span class=\"wizzy-selected-facet-delete\"></span>\n",
      "    </li>\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-facet-range-above-item'>\n",
      "    <li class=\"wizzy-facet-list-item facet-aboveRange-item [[#isSelected]]active[[/isSelected]]\" data-key=\"[[ key ]]\"\n",
      "        data-term=\"[[ value ]][[&symbol]] &amp; above\">\n",
      "    <span class=\"wizzy-facet-list-item-label\">\n",
      "    <span class=\"wizzy-facet-list-item-checkbox\">\n",
      "        <input type=\"checkbox\" class=\"wizzy-facet-list-item-checkbox-input\" [[#isSelected]]checked[[/isSelected]] />\n",
      "        <div class=\"checkbox-indicator\"></div>\n",
      "    </span>\n",
      "    [[ value ]][[&symbol]] [[&sText]]\n",
      "    </span>\n",
      "        <span class=\"wizzy-facet-list-item-count\">\n",
      "    ([[ count ]])\n",
      "    </span>\n",
      "    </li>\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-facet-range-item'>\n",
      "    <li class=\"wizzy-facet-list-item facet-range-item\" data-key=\"[[ key ]]\" data-term=\"[[ label ]]\">\n",
      "        [[#withInputFields]]\n",
      "        <div class=\"wizzy-facet-range-inputs\">\n",
      "            <div class=\"wizzy-range-input-wrapper\">\n",
      "                <input type=\"text\" class=\"wizzy-range-input wizzy-range-min\" value=\"[[ min ]]\" min=\"[[ min ]]\" max=\"[[ max ]]\" placeholder=\"Min\">\n",
      "            </div>\n",
      "            <span class=\"wizzy-range-separator\"> - </span>\n",
      "            <div class=\"wizzy-range-input-wrapper\">\n",
      "                <input type=\"text\" class=\"wizzy-range-input wizzy-range-max\" value=\"[[ max ]]\" min=\"[[ min ]]\" max=\"[[ max ]]\" placeholder=\"Max\">\n",
      "            </div>\n",
      "        </div>\n",
      "        [[/withInputFields]]\n",
      "        <div class=\"wizzy-facet-range-slider\" data-min=\"[[ min ]]\" data-max=\"[[ max ]]\" data-avg=\"[[ avg ]]\">\n",
      "\n",
      "        </div>\n",
      "    </li>\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-selected-facets-block'>\n",
      "    <div class=\"wizzy-filters-selected-facets-block\">\n",
      "        <ul class=\"wizzy-selected-facet-list\">\n",
      "            [[#items]]\n",
      "            [[&html]]\n",
      "            [[/items]]\n",
      "        </ul>\n",
      "    </div>\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-search-empty-results'>\n",
      "    <div class=\"wizzy-search-empty-results-wrapper wizzy-suggestions\">\n",
      "        [[#query]]\n",
      "            <div class=\"wizzy-empty-results-summary\">\n",
      "                <p>You searched for <span class=\"wizzy-empty-searched-query\">[[ query ]]</span></p>\n",
      "            </div>\n",
      "        [[/query]]\n",
      "        <div class=\"wizzy-empty-results-icon\"></div>\n",
      "        <div class=\"wizzy-empty-results-content\">\n",
      "            <h2>[[ title ]]</h2>\n",
      "\n",
      "            [[#query]]\n",
      "            <p>Please check the spelling or try searching for something else.</p>\n",
      "            [[/query]]\n",
      "    \n",
      "            [[#lastRequestId]]\n",
      "            <p class=\"wizzy-req-ref-id\">Ref ID: [[ lastRequestId ]]</p>\n",
      "            [[/lastRequestId]]\n",
      "        </div>\n",
      "        <div class=\"wizzy-search-wrapper\">\n",
      "            <div class=\"wizzy-search-results-wrapper\">\n",
      "                <div class=\"wizzy-search-results-container\">    \n",
      "                    <div class=\"wizzy-search-results\">\n",
      "                        [[#subTitle]]\n",
      "                        <div class=\"wizzy-empty-results-title\">[[subTitle]]</div>\n",
      "                        [[/subTitle]]\n",
      "                        <ul class=\"wizzy-search-results-list\">\n",
      "                            [[#suggestions]]\n",
      "                            [[& html]]\n",
      "                            [[/suggestions]]\n",
      "                        </ul><!-- ending of wizzy-search-results-list -->\n",
      "                    </div>\n",
      "                </div>\n",
      "            </div>\n",
      "        </div>\n",
      "    </div>\n",
      "\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-search-pagination'>\n",
      "    <div class=\"wizzy-pagination-container\">\n",
      "        <ul class=\"wizzy-pagination-list\">\n",
      "            <li class=\"[[^isPrevActive]]inactive[[/isPrevActive]] pagination-arrow previous-arrow\"><a href=\"#\"><span\n",
      "                            class=\"text\">&laquo;</span></a></li>\n",
      "            [[#items]]\n",
      "            <li class=\"[[#isSelected]]active[[/isSelected]] [[customClass]]\" title=\"[[ value ]]\" data-page=\"[[value]]\"><a href=\"#\"><span\n",
      "                            class=\"text\">[[ value ]]</span></a></li>\n",
      "            [[/items]]\n",
      "            <li class=\"[[^isNextActive]]inactive[[/isNextActive]] pagination-arrow next-arrow\"><a href=\"#\"><span\n",
      "                            class=\"text\">&raquo;</span><span class=\"text-mobile\">Show More</span></a></li>\n",
      "        </ul>\n",
      "    </div>\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-search-results-product'>\n",
      "    <li class=\"wizzy-result-product wizzy-product-[[id]]\n",
      "    [[#groupId]]has-variations wizzy-group-product-[[groupId]][[/groupId]]\"\n",
      "        title=\"[[& name ]]\" data-id=\"[[id]]\" data-groupId=\"[[#groupId]][[groupId]][[/groupId]][[#singleVarientGroupId]][[singleVarientGroupId]][[/singleVarientGroupId]]\">\n",
      "\n",
      "    <span class=\"wizzy-product-variation-loader-bg\"></span>\n",
      "    <span class=\"wizzy-product-variation-loader\"></span>\n",
      "\n",
      "    <a href=\"[[&url]]\" class=\"wizzy-result-product-item\">\n",
      "        <div class=\"result-product-item-image\">\n",
      "            <img src=\"[[ mainImage ]]\" class=\"product-item-image\" loading=\"lazy\" />\n",
      "        </div><!-- ending of result-product-item-image -->\n",
      "        <div class=\"result-product-item-image hover-image\">\n",
      "            [[#hoverImage]]\n",
      "            <img src=\"[[ hoverImage ]]\" class=\"product-item-image\" loading=\"lazy\"/>\n",
      "            [[/hoverImage]]\n",
      "            [[^hoverImage]]\n",
      "            <img src=\"[[ mainImage ]]\" class=\"product-item-image\" loading=\"lazy\"/>\n",
      "            [[/hoverImage]]\n",
      "        </div><!-- ending of result-product-item-image -->\n",
      "        <div class=\"result-product-item-info\">\n",
      "            <p class=\"product-item-title\">[[& name ]]</p>\n",
      "            [[#subTitle]]\n",
      "            <p class=\"product-item-sub-title\">[[&subTitle]]</p>\n",
      "            [[/subTitle]]\n",
      "            [[#swatches]]\n",
      "            <div class=\"product-item-swatch-group\n",
      "            [[#isPrimary]]swatch-group-primary[[/isPrimary]] swatch-group-[[key]]\"\n",
      "                 data-swatchKey=\"[[key]]\">\n",
      "                [[#values]]\n",
      "                <div data-variationId=\"[[variationId]]\" title=\"[[#value]][[value]][[/value]]\"\n",
      "                     class=\"product-item-swatch-item\n",
      "                    [[#isSelected]]swatch-selected[[/isSelected]]\n",
      "                    [[#inStock]]swatch-in-stock[[/inStock]]\">\n",
      "\n",
      "                    [[#isSwatch]]\n",
      "                    <span class=\"wizzy-facet-item-swatch-wrapper [[#isVisualSwatch]]facet-visual-swatch[[/isVisualSwatch]]\n",
      "    [[^isVisualSwatch]]facet-text-swatch[[/isVisualSwatch]]\">\n",
      "    <span class=\"wizzy-facet-item-swatch [[#isVisualSwatch]]facet-visual-swatch[[/isVisualSwatch]]\n",
      "        [[^isVisualSwatch]]facet-text-swatch[[/isVisualSwatch]]\"\n",
      "          style=\"[[#isVisualSwatch]][[#isURLSwatch]]background-image:url([[swatchValue]]);[[/isURLSwatch]]\n",
      "            [[^isURLSwatch]]background-color:[[swatchValue]];[[/isURLSwatch]][[/isVisualSwatch]]\">\n",
      "         [[^swatchValue]]\n",
      "                [[#value]]\n",
      "                    <span class=\"wizzy-facet-swatch-individual-value\">[[value]]</span>\n",
      "                [[/value]]\n",
      "        [[/swatchValue]]\n",
      "        [[^isVisualSwatch]]\n",
      "            <span class=\"wizzy-facet-swatch-value\">[[swatchValue]]</span>\n",
      "        [[/isVisualSwatch]]\n",
      "    </span>\n",
      "</span>\n",
      "                    [[/isSwatch]]\n",
      "\n",
      "                </div>\n",
      "                [[/values]]\n",
      "            </div><!-- ending of product-item-swatch-group -->\n",
      "            [[/swatches]]\n",
      "            <div class=\"wizzy-product-item-price-reviews-wrapper\">\n",
      "\n",
      "                <div class=\"wizzy-product-item-reviews\">\n",
      "                    [[#avgRatings]]\n",
      "                    <span class=\"product-item-reviews-avgRatings\">[[avgRatings]]</span><span\n",
      "                            class=\"product-item-review-wrapper\">&#x2605;</span>[[#totalReviews]]<span\n",
      "                            class=\"product-item-reviews-totalReviews\">([[totalReviews]])</span>[[/\n",
      "                    totalReviews]]\n",
      "                    [[/avgRatings]]\n",
      "                </div>\n",
      "\n",
      "                <div class=\"wizzy-product-item-price [[#hasSwatches]]with-swatches[[/hasSwatches]]\">\n",
      "                    [[#price]]\n",
      "                    [[#discountPercentage]]\n",
      "                    <span class=\"product-item-original-price\">\n",
      "                                      [[#priceWithCurrency]][[ price ]][[/priceWithCurrency]]\n",
      "                                 </span>\n",
      "   [[/discountPercentage]]\n",
      "   [[/price]]\n",
      "                    [[#priceWithCurrency]][[ sellingPrice ]][[/priceWithCurrency]]\n",
      "  \n",
      "                    [[#discountPercentage]]\n",
      "                    <br>\n",
      "                    <div class=\"product-item-discount\">                              \n",
      "                                         [[discountPercentage]]% off                                \n",
      "                    </div>\n",
      "                                 [[/discountPercentage]]\n",
      "                </div>\n",
      "\n",
      "                <div class=\"wizzy-product-actions\">\n",
      "                    <div class=\"product_item-actions actions\">\n",
      "\n",
      "                        <div class=\"actions-primary\">\n",
      "                            [[#displayAddToCart]]\n",
      "                                <div class=\"wizzy-product-add-to-cart\">                \n",
      "                                    <form method=\"post\" action=\"/cart/add\">\n",
      "                                    <input type=\"hidden\" name=\"id\" value=\"[[id]]\" />\n",
      "                                    <input min=\"1\" type=\"hidden\" id=\"quantity\" name=\"quantity\" value=\"1\"/>\n",
      "                                    <input type=\"submit\" value=\"Add to Cart\" class=\"wizzy-tocart-button btn button\" />\n",
      "                                    </form>   \n",
      "                                </div>\n",
      "                                [[/displayAddToCart]]\n",
      "                            </div>\n",
      "\n",
      "                        <div class=\"actions-secondary\">\n",
      "                            [[#displayQuickView]]\n",
      "                                <div class=\"wizzy-product-quick-view\">\n",
      "                                    <button class=\"wizzy-quick-view-button\" data-resource=[[quickViewResource]]> <span class=\"wizzy-quick-view-icon\"> </span> <span class=\"wizzy-quick-view-label\">Quick view</span> </button> \n",
      "                                </div>                               \n",
      "                            [[/displayQuickView]]\n",
      "                        </div>\n",
      "\n",
      "\n",
      "                    </div>\n",
      "                </div><!-- ending of wizzy-product-actions -->\n",
      "\n",
      "            </div><!-- ending of wizzy-product-item-price-reviews-wrapper -->\n",
      "        </div><!-- ending of result-product-item-info -->\n",
      "    </a><!-- ending of wizzy-result-product-item -->\n",
      "    </li><!-- ending of wizzy-result-product -->\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-search-results'>\n",
      "    <ul class=\"wizzy-search-results-list\">\n",
      "        [[#products]]\n",
      "        [[& html ]]\n",
      "        [[/products]]\n",
      "    </ul><!-- ending of wizzy-search-results-list -->\n",
      "</script>\n",
      "<script type='text/template' id='wizzy-search-sort'>\n",
      "    <div class=\"wizzy-sort-container\" [[#hasToDisplayFiltersAtTop]] style=\"top:[[filtersButtonOffset]]px\"[[/hasToDisplayFiltersAtTop]]>\n",
      "        <select class=\"wizzy-sort-select\" id=\"wizzy-sort-select\">\n",
      "            [[#options]]\n",
      "            <option value=\"[[ field ]]\"\n",
      "                    data-order=\"[[order]]\"\n",
      "                    [[#isSelected]]selected[[/isSelected]]>\n",
      "            [[ label ]]\n",
      "            </option>\n",
      "            [[/options]]\n",
      "        </select>\n",
      "        [[#displayTileView]]\n",
      "            <div class=\"wizzy-tile-view-icon\">\n",
      "                <button class=\"wizzy-tile-view-button\" aria-label=\"Zoom in and out\" data-value=\"4\">\n",
      "                [[#tileViewConfig]]\n",
      "                <div class=\"wizzy-tile-view-icon-grid [[#isActive]] wizzy-filled-grid [[/isActive]]\"></div>\n",
      "                [[/tileViewConfig]] \n",
      "                </button>\n",
      "            </div>\n",
