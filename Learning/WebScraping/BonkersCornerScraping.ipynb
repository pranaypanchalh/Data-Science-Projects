      "}\n",
      "  \n",
      "\n",
      "    debouncedMyTimer();\n",
      "  });\n",
      "  const debouncedMyTimer = debounce(() => {\n",
      "    observer.disconnect();\n",
      "    enableGokwikCart();\n",
      "    observer.observe(targetElement, { childList: true, subtree: true });\n",
      "  }, 700);\n",
      "  function enableGokwikCart() {\n",
      "      $('.gokwik-checkout button').prop('disabled', false);\n",
