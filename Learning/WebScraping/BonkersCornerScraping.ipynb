      "<script>\n",
      "  document.addEventListener('DOMContentLoaded', () => {\n",
      "    // Slide out the current panel and remove .active after transition\n",
      "    function slideOutAndRemoveActive(panel) {\n",
      "      if (!panel) return;\n",
      "\n",
      "      panel.classList.add('slide-right');\n",
      "\n",
      "      panel.addEventListener('transitionend', function handleTransitionEnd(e) {\n",
      "        if (e.target !== panel) return;\n",
      "        panel.classList.remove('slide-right');\n",
      "        panel.classList.remove('active');\n",
      "        panel.removeEventListener('transitionend', handleTransitionEnd);\n",
      "      });\n",
      "    }\n",
      "\n",
      "    // Slide in the target panel (from right to left)\n",
      "    function slideInPanel(panel) {\n",
      "      if (!panel) return;\n",
      "\n",
      "      panel.classList.remove('slide-left', 'slide-right');\n",
      "      panel.classList.add('active');\n",
      "    }\n",
      "\n",
      "    // Slide in the previous panel from the left\n",
      "    function slideInFromLeft(panel) {\n",
      "      if (!panel) return;\n",
      "\n",
      "      panel.classList.add('slide-left', 'active');\n",
      "      void panel.offsetWidth; // force reflow\n",
      "      panel.classList.remove('slide-left');\n",
      "    }\n",
      "\n",
      "    // Show next panel (used when clicking L1 → L2 or L2 → L3)\n",
      "    function showPanel(targetId) {\n",
      "      const targetPanel = document.getElementById(targetId);\n",
      "      slideInPanel(targetPanel);\n",
      "    }\n",
      "\n",
      "    // Hide current panel and show previous one\n",
      "    function hidePanel(currentPanel, backToId) {\n",
      "      const previousPanel = document.getElementById(backToId);\n",
      "      if (!previousPanel || !currentPanel) return;\n",
      "\n",
      "      // Only slide out and remove active if not L1\n",
      "      if (!currentPanel.id.includes('menu-l1')) {\n",
      "        slideOutAndRemoveActive(currentPanel);\n",
      "      }\n",
      "\n",
      "      // Don't animate L1, just activate it\n",
      "      if (previousPanel.id.includes('menu-l1')) {\n",
      "        previousPanel.classList.add('active');\n",
      "      } else {\n",
      "        slideInFromLeft(previousPanel);\n",
      "      }\n",
      "    }\n",
      "\n",
      "    // L1 → L2\n",
      "    document.querySelectorAll('[data-l2]').forEach((item) => {\n",
      "      item.addEventListener('click', () => {\n",
      "        const targetId = item.getAttribute('data-l2');\n",
      "        showPanel(targetId);\n",
      "      });\n",
      "    });\n",
      "\n",
      "    // L2 → L3\n",
      "    document.querySelectorAll('[data-l3]').forEach((item) => {\n",
      "      item.addEventListener('click', () => {\n",
      "        const targetId = item.getAttribute('data-l3');\n",
      "        showPanel(targetId);\n",
      "      });\n",
      "    });\n",
      "\n",
      "    // Back buttons\n",
      "    document.querySelectorAll('.custom-header-menu-drawer__back-button').forEach((btn) => {\n",
      "      btn.addEventListener('click', () => {\n",
      "        const currentPanel = btn.closest('.custom-header-menu-drawer__menu-column');\n",
      "        const backToId = btn.getAttribute('data-back');\n",
      "\n",
      "        hidePanel(currentPanel, backToId);\n",
      "      });\n",
      "    });\n",
      "  });\n",
      "\n",
      "  document.addEventListener('DOMContentLoaded', function () {\n",
      "    function headerMenuCloseButton() {\n",
      "      const closeBtnEl = document.querySelector('.custom-header-menu-drawer__close-button');\n",
      "      const mobileToggleBtnEl = document.querySelector('.mobile-toggle');\n",
      "      closeBtnEl?.addEventListener('click', () => {\n",
      "        mobileToggleBtnEl?.click();\n",
      "      });\n",
      "    }\n",
      "    headerMenuCloseButton();\n",
      "\n",
      "    function headerMenuTabsBtn() {\n",
      "      const tabsList = document.querySelectorAll('.custom-header-menu-drawer__tab-btn');\n",
      "      const menuItemsList = document.querySelectorAll('.custom-header-menu-drawer__menu-item--tab');\n",
      "      tabsList.forEach((tab) => {\n",
      "        tab.addEventListener('click', () => {\n",
      "          const tabTitle = tab.textContent.trim().toLowerCase();\n",
      "          menuItemsList.forEach((eachMenu) => {\n",
      "            const menuL1Title = eachMenu.dataset.l1Title.trim().toLowerCase();\n",
      "            if (menuL1Title === tabTitle) {\n",
      "              eachMenu.classList.add('active');\n",
      "            } else {\n",
      "              eachMenu.classList.remove('active');\n",
      "            }\n",
      "            tabsList.forEach((tab) => {\n",
      "              tab.classList.remove('active');\n",
      "            });\n",
      "            tab.classList.add('active');\n",
      "          });\n",
      "        });\n",
      "      });\n",
      "    }\n",
      "\n",
      "    headerMenuTabsBtn();\n",
      "  });\n",
      "</script></details>\n",
      "</div>\n",
