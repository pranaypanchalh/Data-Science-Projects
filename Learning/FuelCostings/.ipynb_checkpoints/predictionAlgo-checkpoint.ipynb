    "import pandas as pd\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "\n",
    "model = RandomForestRegressor()\n",
    "\n",
    "data = pd.read_csv(\"fuel_log.csv\")\n",
    "\n",
    "x = data[[\"distance\"]]   # 2D — features\n",
    "y = data[\"cost\"]          # 1D — target\n",
    "\n",
    "model.fit(x, y)\n",
    "model.predict([[6000]])"
   ]
  }
